<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">New Password for @u.userId</MudText>
        <MudForm @ref="form">
            <MudTextField Label="Password" InputType="InputType.Password" @bind-Value="@newPassword" For="@(() => newPassword)" />
            <MudTextField Label="Repeat Password" InputType="InputType.Password" @bind-Value="@newPassword2" For="@(() => newPassword2)" />
            @if (Global.app.par["EnableComplexPasswords"] > 0)
            {
            <MudText Typo="Typo.body2" Color="Color.Primary">Passwords must be at least @User.passwordLengthMin chars long,<br /> 
                and contain at least one lowercase, <br />one uppercase char and one digit.</MudText>
            }
        </MudForm>

        @if (pwstatus != null)
        {
            <MudAlert Severity="@severity" Dense="true">@pwstatus</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public User u { get; set; }

    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; }

    [CascadingParameter]
    Task<AuthenticationState> authenticationStateTask { get; set; }

    ClaimsPrincipal user;
    string newPassword;
    string newPassword2;
    MudForm form;
    string pwstatus;
    Severity severity;

    protected override async void OnInitialized()
    {
        user = (await authenticationStateTask).User;

        newPassword = "";
        newPassword2 = "";
    }

    private void Submit() 
    {
        // check password
        if (newPassword != newPassword2)
        {
            severity = Severity.Error;
            pwstatus = "New passwords do not match.";
            return;       
        }

        // check password complexity
        if (Global.app.par["EnableComplexPasswords"] > 0)
        {
            if (!User.CheckPasswordComplexity(newPassword))
            {
                severity = Severity.Error;
                pwstatus = string.Format("Password complexity check fails.", 
                           User.passwordLengthMin);
                return;
            }
        }

        u.password = newPassword;

        MudDialog.Close();
    }

    void Cancel() => MudDialog.Cancel();
}

