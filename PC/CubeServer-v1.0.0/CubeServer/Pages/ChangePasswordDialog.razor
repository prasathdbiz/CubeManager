<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Change Password</MudText>
        <MudForm @ref="form">
            <MudTextField ReadOnly="true" Label="User ID" @bind-Value="u.userId" For="@(() => u.userId)" />
            <MudTextField Label="Old Password" InputType="InputType.Password" @bind-Value="@oldPassword" For="@(() => oldPassword)" />
                <MudTextField Label="Password" InputType="InputType.Password" @bind-Value="@newPassword" For="@(() => newPassword)" />
                <MudTextField Label="Repeat Password" InputType="InputType.Password" @bind-Value="@newPassword2" For="@(() => newPassword2)" />
            @if (Global.app.par["EnableComplexPasswords"] > 0)
            {
            <MudText Typo="Typo.body2" Color="Color.Primary">Passwords must be at least @User.passwordLengthMin chars long, 
                and contains at least one lowercase, one uppercase and one digit.</MudText>
            }
        </MudForm>

        @if (pwstatus != null)
        {
            <MudAlert Severity="@severity" Dense="true">@pwstatus</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; }

    [CascadingParameter]
    Task<AuthenticationState> authenticationStateTask { get; set; }

    ClaimsPrincipal user;
    User u;
    string oldPassword;
    string newPassword;
    string newPassword2;
    MudForm form;
    string pwstatus;
    Severity severity;

    protected override async void OnInitialized()
    {
        user = (await authenticationStateTask).User;
        u = Global.db.GetUser(user.Identity.Name);

        oldPassword = "";
        newPassword = "";
        newPassword2 = "";
    }

    async void Submit() 
    {
        // check password
        if (newPassword != newPassword2)
        {
            severity = Severity.Error;
            pwstatus = "New passwords do not match.";
            return;       
        }

        // check old password
        if (u.password != Util.EncryptPassword(oldPassword, u.privilege))
        {
            severity = Severity.Error;
            pwstatus = "Old password does not match.";
            return;
        }

        // check password complexity
        if (Global.app.par["EnableComplexPasswords"] > 0)
        {
            if (!User.CheckPasswordComplexity(newPassword))
            {
                severity = Severity.Error;
                pwstatus = string.Format("Password complexity check fails. " + 
                           "Please ensure password has at least length of {0}, " +
                           "one lowercase char, one uppercase char and one digit.", 
                           User.passwordLengthMin);
                return;
            }
        }

        u.password = Util.EncryptPassword(newPassword, u.privilege);
        bool status = Global.db.UpdateUser(u, true, Global.userName);
        if (status)
        {
            severity = Severity.Success;
            pwstatus = "Password Changed.";
            await Task.Delay(2000);

            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    void Cancel() => MudDialog.Cancel();
}

