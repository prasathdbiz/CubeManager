@page "/GenerateReports"
@attribute [Authorize(Roles = "Administrator, DataEntry")]

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Hosting
@inject IJSRuntime JS
@inject NavigationManager navman
@inject IDialogService Dialog

<PageTitle>Generate Reports</PageTitle>

@if (!dataAvail)
{
    <p><em>Loading...</em></p>
}
else
{
    if (statusMessage != null)
    {
        <MudAlert Severity="Severity.Error">@statusMessage</MudAlert>
    }

    @if (Util.CanEdit(user, editRoles))
    {
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Report Type" Placeholder="Select Report Type" AnchorOrigin="Origin.BottomCenter" ValueChanged="ReportSelected">
                    <MudSelectItem Value="@("Daily")" />
                    <MudSelectItem Value="@("Monthly")" />
                    <MudSelectItem Value="@("Statistical")" />
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Label="@date1Str" @bind-Date="date1" For="@(() => date1)" Class="me-4"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            @if (date2required)
            {
                <MudItem xs="12" md="3">
                    <MudDatePicker Label="End Date" @bind-Date="date2" For="@(() => date2)" Class="me-4"
                               DateFormat="yyyy-MM-dd" />
                </MudItem>
            }
            <MudItem xs="12" md="3">
                <MudTextField Label="Test Age" @bind-Value="testAge" For="@(() => testAge)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField ReadOnly="true" Label="Project ID" Placeholder="Select Project" @bind-Value="projectCode" For="@(() => projectCode)"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.MoreVert" OnAdornmentClick="SelectReport" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int?" Label="Grade" Placeholder="All Grades" AnchorOrigin="Origin.BottomCenter" @bind-Value="filterGrade" Clearable="true">
                    @foreach (int g in grades)
                    {
                        <MudSelectItem Value="@((int?)g)">@g</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Supplier" Placeholder="All Suppliers" AnchorOrigin="Origin.BottomCenter" @bind-Value="filterSupplierId" Clearable="true">
                    @foreach (Supplier s in suppliers)
                    {
                        <MudSelectItem Value="@(s.Id)">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="double?" Label="Dimension" Placeholder="All Dimensions" AnchorOrigin="Origin.BottomCenter" @bind-Value="filterDimension" Clearable="true">
                    @foreach (double d in dimensions)
                    {
                        <MudSelectItem Value="@((double?)d)">@d mm</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.RemoveRedEye"
                            OnClick="@(() => GenerateReport())" Class="px-4 mt-4">Generate Report</MudButton>
            </MudItem>
            <MudItem xs="12" md="6">
                <CubeServer.Features.ReportSignature.ReportSignatureUpload UserId="@user?.Identity?.Name" />
            </MudItem>
            @if (reportType == "Daily")
            {
                <MudItem xs="12" md="3">
                    <MudButton Style="@($"color:{Colors.Shades.Black}; background:{Colors.Purple.Accent2};")" 
                    Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Email"
                    OnClick="@(() => EmailReport())" Class="px-6 mt-4">Email Report</MudButton>
                    @if (updateInProgress)
                    {
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    }
                </MudItem>
            }
            @* <MudItem xs="12" md="3">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Update"
                           OnClick="@(() => UpdateData())" Class="px-6 mt-4">Update Data</MudButton>
                @if (updateInProgress)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
            </MudItem> *@
        </MudGrid>
    }
    @if (reportInProgress)
    {
        <MudProgressLinear Color="Color.Info" Indeterminate="true" />
    }
    <MudPaper MaxWidth="100%" Height="700px" Class="mt-4">
        <iframe id="pdfview" src="@pdffile" style="width: 100%;height: 100%;border: none;"></iframe>
        @* <embed src="Reports/a.pdf" width="1000" height="800" type="application/pdf" /> *@
    </MudPaper>
    @* <MudDataGrid @ref="table" Items="@reports" Hover="true" ColumnResizeMode="ResizeMode.Container" Class="xs-12 mt-3"
                 RowClassFunc="@SelectedRowClassFunc" RowClick="@RowClicked" SelectedItemChanged="@OnSelectedItemChanged" T="Report" 
                 QuickFilter="@QuickFilter">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="Report Id" />
            <PropertyColumn Property="x => x.ProjectCode" Title="Project ID" />
            <PropertyColumn Property="x => x.ReportType" Title="Report Type" />
            <PropertyColumn Property="x => x.FileName" Title="File name" />
            <PropertyColumn Property="x => x.ReportDate" Title="Date" Format="yyyy-MM-dd HH:mm:ss"/>
            <PropertyColumn Property="x => ReleaseStr(x.Released)" Title="Released" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Report" PageSizeOptions=@(new int[] {10, 25, 50}) />
        </PagerContent>
    </MudDataGrid> *@
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    [Inject] private IDialogService DialogService { get; set; }

    ClaimsPrincipal user;
    string[] editRoles = { "Administrator", "Reporting" };

    bool dataAvail;
    MudDataGrid<Report> table;
    List<Report> reports;
    Report selectedItem;
    string statusMessage;
    int totalReports;
    string searchStr;
    int testAge = 0;

    string reportType = "";
    DateTime? date1, date2;
    string date1Str = "Start Date";
    bool date2required = true;
    string pdffile = "Reports/a.pdf";

    string projectCode;
    bool reportInProgress = false;
    bool updateInProgress = false;

    int? filterGrade;
    string filterSupplierId;
    double? filterDimension;
    List<int> grades = new List<int>();
    List<Supplier> suppliers = new List<Supplier>();
    List<double> dimensions = new List<double> { 50, 100, 150 };

    int curPage { get; set; } = 1;
    int totalPages { get; set; } = 1;
    private int selectedRowNumber = -1;

    ReportResult reportResult;
    ReportState reportState;
    bool reportSaved;


    protected override async void OnInitialized()
    {
        user = (await authenticationStateTask).User;

        int total;
        Global.db.GetSuppliers(suppliers, out total);
    }

    protected override void OnParametersSet()
    {
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            dataAvail = true;

            StateHasChanged();
        }
    }

    private async void GenDisplayReport()
    {
        bool status;
        reports = new List<Report>();
        int projectId;
        status = int.TryParse(projectCode.Substring(1), out projectId);
        try
        {
            Project p = Global.db.GetProject(projectId);
            if (p == null) return;

            if (reportType == "Daily" && date1.HasValue)
            {
                reportInProgress = true;
                reportResult = await Global.reportGenerator.GenerateDailyReport(projectId,
                    (DateTime)date1, user.Identity.Name,
                    filterGrade, filterSupplierId, filterDimension, testAge);
                if (reportResult.pdffile != null)
                {
                    reportState = new ReportState()
                        {
                            project = p,
                            reportType = reportType,
                            date1 = date1,
                            testAge = testAge,
                            filterGrade = filterGrade,
                            filterSupplierId = filterSupplierId,
                            filterDimension = filterDimension
                        };

                    pdffile = Path.Combine("Reports", reportResult.pdffile);
                    statusMessage = null;

                    reportSaved = await SaveReport();
                }
                else
                {
                    reportState = null;
                    statusMessage = reportResult.resultCnt == 0
                        ? "No cube test data found matching the selected filters."
                        : "Error generating report.";
                }
                reportInProgress = false;
            }
            else if (reportType == "Monthly" && date1.HasValue && date2.HasValue)
            {
                reportInProgress = true;
                status = Global.dataAnalyzer.CalcRollingAvgStrength();
                if (status)
                {
                    reportResult = await Global.reportGenerator.GenerateMonthlyReport(projectId,
                        (DateTime)date1, (DateTime)date2, user.Identity.Name,
                        filterGrade, filterSupplierId, filterDimension, testAge);
                    if (reportResult.pdffile != null)
                    {
                        reportState = new ReportState()
                            {
                                project = p,
                                reportType = reportType,
                                date1 = date1,
                                date2 = date2,
                                testAge = testAge,
                                filterGrade = filterGrade,
                                filterSupplierId = filterSupplierId,
                                filterDimension = filterDimension
                            };


                        pdffile = Path.Combine("Reports", reportResult.pdffile);
                        statusMessage = null;

                        reportSaved = await SaveReport();
                    }
                    else
                    {
                        reportState = null;
                        statusMessage = reportResult.resultCnt == 0
                            ? "No cube test data found matching the selected filters."
                            : "Error generating report.";
                    }
                }
                else
                {
                    reportState = null;
                    statusMessage = "Error updating data.";
                }
                reportInProgress = false;
            }
            else if (reportType == "Statistical" && date1.HasValue && date2.HasValue)
            {
                reportInProgress = true;
                status = Global.dataAnalyzer.CalcRollingAvgStrength();
                if (status)
                {
                    reportResult = await Global.reportGenerator.GenerateStatisticalReport(projectId,
                        (DateTime)date1, (DateTime)date2, testAge, user.Identity.Name,
                        filterGrade, filterSupplierId, filterDimension);
                    if (reportResult.pdffile != null)
                    {
                        reportState = new ReportState()
                            {
                                project = p,
                                reportType = reportType,
                                date1 = date1,
                                date2 = date2,
                                testAge = testAge,
                                filterGrade = filterGrade,
                                filterSupplierId = filterSupplierId,
                                filterDimension = filterDimension
                            };

                        pdffile = Path.Combine("Reports", reportResult.pdffile);
                        statusMessage = null;

                        reportSaved = await SaveReport();
                    }
                    else
                    {
                        reportState = null;
                        statusMessage = reportResult.resultCnt == 0
                            ? "No cube test data found matching the selected filters."
                            : "Error generating report.";
                    }
                }
                else
                {
                    reportState = null;
                    statusMessage = "Error updating data.";
                }
                reportInProgress = false;
            }

            dataAvail = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            dataAvail = true;
            if (statusMessage != null)
            {
                statusMessage += "; " + ex.Message;
            }
            else
            {
                statusMessage = ex.Message;
            }
            reportInProgress = false;
        }
    }

    private void OnSelectedItemChanged()
    {

    }

    private string ReleaseStr(int release)
    {
        if (release == 1) return "Manual Released";
        else if (release == 2) return "Auto Released";
        else return "No";
    }

    private void EditReport(Report p)
    {
        navman.NavigateTo($"/Reports/Edit/{p.Id}");
    }

    private void GenerateReport()
    {
        if (projectCode != null)
        {
            GenDisplayReport();
        }
    }

    private async void UpdateData()
    {
        updateInProgress = true;
        await Task.Run(() => Global.dataAnalyzer.CalcRollingAvgStrength());
        updateInProgress = false;

        StateHasChanged();
    }

    private async Task<bool> SaveReport()
    {
        bool status = false;
        bool exists;
        List<Report> reports = new List<Report>();
        Report report = null;

        if (reportResult != null && reportResult.resultCnt > 0)
        {
            try
            {
                exists = Global.db.ReportExists(reportState);
                if (exists)
                {
                    bool? result = await DialogService.ShowMessageBox("Save Report",
                    $"This report already exists. Do you want to replace the {reportType} Report for Project {projectCode}?",
                    yesText: "Replace!", cancelText: "No. Keep Current Report.");

                    if (result == null) return false;

                    if (Global.db.GetReports(reportState.project.Id, "All", reportState.reportType, reports, 
                        reportState.date1, reportState.date2) && reports.Count > 0)
                    {
                        report = reports[0];
                    }
                    else
                    {
                        statusMessage = "Error reading existing report into database.";
                        Global.logger.LogMessageEx("Error", "Error reading {0} report for project {1}.",
                            reportState.reportType, reportState.project.ProjectCode);
                        return false;
                    }
                }

                if (report == null)
                {
                    report = new Report();
                    report.ProjectId = reportState.project.Id;
                    report.ReportType = reportState.reportType;
                    report.FileName = reportResult.pdffile;
                    report.ReportDate = DateTime.Now;
                    report.StartDate = reportState.date1;
                    report.EndDate = reportState.date2;
                    report.EmailTo = reportState.project.EmailAddr;
                    report.EmailCC = reportState.project.EmailCC;
                    report.Released = 0; // not released
                    report.ReleaseUser = user.Identity.Name;
                    report.ReleaseDate = null;
                }

                string file = string.Format("{0}\\{1}\\{2}", reportState.reportType,
                    reportState.date1.ToString("yyyyMMdd"), Path.GetFileName(reportResult.pdffile));
                string dest = Path.Combine(Global.reportStoragePath, file);
                string destDir = Path.GetDirectoryName(dest);
                if (!Directory.Exists(destDir)) Directory.CreateDirectory(destDir);


                try
                {
                    string src = Path.Combine(Global.reportPath, reportResult.pdffile);
                    File.Copy(src, dest, true);

                    if (exists)
                    {
                        string oldFile = string.Format("{0}\\{1}\\{2}", reportState.reportType,
                            reportState.date1.ToString("yyyyMMdd"), Path.GetFileName(report.FileName));
                        oldFile = Path.Combine(Global.reportStoragePath, oldFile);
                        if (System.IO.File.Exists(oldFile)) File.Delete(oldFile);

                        report.FileName = reportResult.pdffile;

                        status = Global.db.UpdateReport(report, user.Identity.Name);
                        if (!status)
                        {
                            statusMessage = "Error updating report into database.";
                            Global.logger.LogMessageEx("Error", "Error updating {0} report for project {1}.",
                                reportState.reportType, reportState.project.ProjectCode);
                        }
                    }
                    else
                    {
                        status = Global.db.InsertReport(report, user.Identity.Name);
                        if (!status)
                        {
                            statusMessage = "Error inserting report into database.";
                            Global.logger.LogMessageEx("Error", "Error inserting {0} report for project {1}.",
                                reportState.reportType, reportState.project.ProjectCode);
                        }
                    }

                }
                catch (Exception ex)
                {
                    statusMessage = "Error moving report files.";
                    Global.logger.LogMessageEx("Error", "Error moving file {0} to destination: {1}",
                        reportResult.pdffile, ex.Message);
                    status = false;
                }
            }
            catch (Exception ex)
            {
                dataAvail = true;
                if (statusMessage != null)
                {
                    statusMessage += "; " + ex.Message;
                }
                else
                {
                    statusMessage = ex.Message;
                }
                status = false;
            }
        }

        return status;
    }

    private async void EmailReport()
    {
        bool status;

        if (reportState == null || reportResult == null || reportResult.resultCnt == 0) return;
        if (reportState.reportType != "Daily") return;

        bool? result = await DialogService.ShowMessageBox("Email Report",
            $"Do you want to Email the current {reportType} Report for Project {projectCode}?",
            yesText: "Send!", cancelText: "Cancel");

        if (result == null) return;
        try
        {
            if (!Global.db.ReportExists(reportState))
            {
                result = await DialogService.ShowMessageBox("Email Report",
                $"This report does not exist. Generate it first.");

                return;
            }

            if (reportResult != null && reportResult.resultCnt > 0)
            {
                try
                {
                    // email
                    if (reportType == "Daily")
                    {
                        status = Global.emailer.SendDailyReport(reportState);
                        if (status)
                        {
                            result = await DialogService.ShowMessageBox("Email Report",
                            $"{reportType} Report for Project {projectCode} sent.");
                        }
                        else
                        {
                            statusMessage = "Error sending Daily Report.";
                            Global.logger.LogMessageEx("Error", "Error sending Daily Report.");
                        }
                    }


                }
                catch (Exception ex)
                {
                    statusMessage = "Error moving report files.";
                    Global.logger.LogMessageEx("Error", "Error moving file {0} to destination: {1}",
                        reportResult.pdffile, ex.Message);
                }
            }
        }
        catch (Exception ex)
        {
            dataAvail = true;
            if (statusMessage != null)
            {
                statusMessage += "; " + ex.Message;
            }
            else
            {
                statusMessage = ex.Message;
            }
        }

        StateHasChanged();

    }

    // events
    private string SelectedRowClassFunc(Report p, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (table.SelectedItem != null && table.SelectedItem.Equals(p))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    private void RowClicked(DataGridRowClickEventArgs<Report> args)
    {
        long i = args.MouseEventArgs.Detail;
        if (i > 1)
        { // double click
            navman.NavigateTo($"/Reports/View/{args.Item.Id}");
        }
    }

    private void SelectedItemsChanged(HashSet<Quotation> items)
    {
        int i = items.Count;
    }

    // quick filter - filter globally across multiple columns with the same input
    private Func<Report, bool> QuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(searchStr))
            return true;

        if (x.ReportType.Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.FileName.Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.ReportDate.ToString("yyyy-MM-dd").Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.ReleaseDate.ToString("yyyy-MM-dd").Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };

    private async void SelectReport()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, NoHeader = true };
        var parameters = new DialogParameters<ProjectSelect>();
        parameters.Add(x => x.reportType, reportType);
        parameters.Add(x => x.date1, date1);
        parameters.Add(x => x.date2, date2);

        var dialog = await DialogService.ShowAsync<ProjectSelect>("Select Project", parameters, options);
        var result = await dialog.Result;

        if (result.Data != null)
        {
            Project p = (Project)result.Data;
            projectCode = p.ProjectCode;

            filterGrade = null;
            filterSupplierId = null;
            filterDimension = null;
            Global.db.GetDistinctConcreteGrades(p.Id, grades);

            StateHasChanged();
        }
    }

    private void ReportSelected(string selected)
    {
        if (selected == "Daily")
        {
            reportType = selected;
            date1Str = "Date";
            date2required = false;
        }
        else if (selected == "Monthly")
        {
            reportType = selected;
            date1Str = "Start Date";
            date2required = true;
        }
        else if (selected == "Statistical")
        {
            reportType = selected;
            date1Str = "Start Date";
            date2required = true;
        }

        StateHasChanged();
    }
}

