@page "/Dashboard"

<PageTitle>Dashboard</PageTitle>

@attribute [Authorize(Roles = "Administrator, DataEntry, Service")]

@using Microsoft.AspNetCore.WebUtilities
@inject IJSRuntime JS
@inject NavigationManager navman
@inject IDialogService Dialog

<PageTitle>Cubes</PageTitle>

@if (!dataAvail)
{
    <p><em>Loading...</em></p>
}
else
{
    if (statusMessage != null)
    {
        <MudAlert Severity="Severity.Error">@statusMessage</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" md="10">
            <MudText Typo="Typo.h6" >Cubes To Be Tested Today</MudText>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudTextField @bind-Value="searchStr" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                        AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </MudItem>
    </MudGrid>

    <MudDataGrid @ref="table" Items="@cubeList" Hover="true" ColumnResizeMode="ResizeMode.Column" Class="xs-12 mt-3"
                 RowClassFunc="@SelectedRowClassFunc" RowClick="@RowClicked" SelectedItemChanged="@OnSelectedItemChanged"
                 T="Cube" QuickFilter="@QuickFilter" Dense>
        <Columns>
            <PropertyColumn Property="x => x.Barcode" Title="Barcode" Format="D8" />
            <PropertyColumn Property="x => x.SampleRef" Title="Sample Ref" />
            <PropertyColumn Property="x => x.BatchNum" Title="Batch ID" />
            <PropertyColumn Property="x => x.MeasuredWeight" Title="Measured Weight (kg)" Format="0.0" />
            <PropertyColumn Property="x => x.MeasuredStrength" Title="Measured Strength (MPa)" Format="0.0" />
            <PropertyColumn Property="x => x.TesterId" Title="Tester ID" />
            <PropertyColumn Property="x => Util.TestResultStr(x.TestResult)" Title="Test Result" />
            <PropertyColumn Property="x => x.StatusCode" Title="Status Code" />
            <PropertyColumn Property="x => Util.DateOnly(x.ActualTestDate)" Title="Actual Test Date" />
            <PropertyColumn Property="x => x.UploadTime" Title="Upload Time" Format="yyyy-MM-dd HH:mm:ss" />

        </Columns>
        <PagerContent>
            <MudDataGridPager T="Cube" PageSizeOptions=@(new int[] {10, 25, 50}) />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    [Inject] private IDialogService DialogService { get; set; }

    ClaimsPrincipal user;
    string[] editRoles = { "Administrator" };

    bool dataAvail;
    MudDataGrid<Cube> table;
    List<Cube> cubeList = new List<Cube>();
    Cube selectedItem;
    string statusMessage;
    int totalCubes;
    string searchStr;

    int curPage { get; set; } = 1;
    int totalPages { get; set; } = 1;
    private int selectedRowNumber = -1;

    IList<IBrowserFile> files = new List<IBrowserFile>();

    List<Batch> batches = new List<Batch>();

    protected override async void OnInitialized()
    {
        user = (await authenticationStateTask).User;
    }

    protected override void OnParametersSet()
    {
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Display();
        }
    }

    private void Display()
    {
        bool status = false;

        try
        {
            status = Global.db.GetBatchesForTest(batches);

            cubeList.Clear();

            status = Global.db.GetCubesForToday(cubeList, CubeQueryOption.All, false);

            dataAvail = true;
            if (!status)
            {
                statusMessage = "Error reading Cube data from database.";
                totalCubes = 0;
                return;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            dataAvail = true;
            if (statusMessage != null)
            {
                statusMessage += "; " + ex.Message;
            }
            else
            {
                statusMessage = ex.Message;
            }
            totalCubes = 0;
        }
    }

    private void OnSelectedItemChanged()
    {

    }


    // events
    private string SelectedRowClassFunc(Cube c, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (table.SelectedItem != null && table.SelectedItem.Equals(c))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    private void RowClicked(DataGridRowClickEventArgs<Cube> args)
    {
        long i = args.MouseEventArgs.Detail;
        if (i > 1)
        { // double click
            navman.NavigateTo($"/Cubes/View/{args.Item.Barcode}");
        }
    }

    private void SelectedItemsChanged(HashSet<Cube> items)
    {
        int i = items.Count;
    }

    // quick filter - filter globally across multiple columns with the same input
    private Func<Cube, bool> QuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(searchStr))
            return true;

        if (x.BatchId.ToString().Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.Barcode.ToString().Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.TesterId.ToString().Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleRef.Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
}


