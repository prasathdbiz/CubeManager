@page "/CubeSets"
@attribute [Authorize(Roles = "Administrator, DataEntry, Service")]

@using Microsoft.AspNetCore.WebUtilities
@inject IJSRuntime JS
@inject NavigationManager navman
@inject IDialogService Dialog

<PageTitle>CubeSets</PageTitle>

@if (!dataAvail)
{
    <p><em>Loading...</em></p>
}
else
{
    if (statusMessage != null)
    {
        <MudAlert Severity="Severity.Error">@statusMessage</MudAlert>
    }

    @if (Util.CanEdit(user, editRoles))
    {
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@NewCubeSet">New CubeSet</MudButton>
            </MudItem>
            <MudSpacer />
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="searchStr" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </MudItem>
            <MudSpacer></MudSpacer>
            @if (Util.CanEdit(user, editRoles))
            {
                <MudItem xs="12" md="4" Style="text-align:right">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="@(() => EditSelectedCubeSet())" Class="px-6">Edit</MudButton>
                    <MudButton Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@(() => DeleteSelectedCubeSet())" Class="ms-4">Delete</MudButton>
                </MudItem>
            }
        </MudGrid>
    }

    <MudDataGrid @ref="table" Items="@cubeSets" Hover="true" ColumnResizeMode="ResizeMode.Column" Class="xs-12 mt-3"
                 RowClassFunc="@SelectedRowClassFunc" RowClick="@RowClicked" SelectedItemChanged="@OnSelectedItemChanged"
                 T="CubeSet" QuickFilter="@QuickFilter">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="CubeSet ID" />
            <PropertyColumn Property="x => x.ProjectCode" Title="Project ID" />
            <PropertyColumn Property="x => x.CastingDate" Title="Casting Date" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.SpecId" Title="Spec ID" />
            <PropertyColumn Property="x => x.TestCriteria" Title="Test Criteria" />
            <PropertyColumn Property="x => x.ConcreteGrade" Title="Concrete Grade" />
            <PropertyColumn Property="x => x.ConcreteType" Title="Concrete Type" />
            <PropertyColumn Property="x => x.CharacteristicStrength" Title="Charateristic Strength (MPa)" />
            <PropertyColumn Property="x => x.StdDeviation" Title="Standard Deviation" />
            <PropertyColumn Property="x => x.SupplierId" Title="Supplier ID" />

        </Columns>
        <PagerContent>
            <MudDataGridPager T="CubeSet" PageSizeOptions=@(new int[] {10, 25, 50}) />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    [Inject] private IDialogService DialogService { get; set; }

    ClaimsPrincipal user;
    string[] editRoles = { "Administrator", "DataEntry" };

    bool dataAvail;
    MudDataGrid<CubeSet> table;
    List<CubeSet> cubeSets;
    CubeSet selectedItem;
    string statusMessage;
    int totalCubeSets;
    string searchStr;

    int curPage { get; set; } = 1;
    int totalPages { get; set; } = 1;
    private int selectedRowNumber = -1;

    IList<IBrowserFile> files = new List<IBrowserFile>();
    //protected TablePagination pagination;

    protected override async void OnInitialized()
    {
        user = (await authenticationStateTask).User;
    }

    protected override void OnParametersSet()
    {
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Display();
        }
    }

    private void Display()
    {
        cubeSets = new List<CubeSet>();
        try
        {
            bool status = Global.db.GetCubeSets(cubeSets, out totalCubeSets);
            dataAvail = true;
            if (!status)
            {
                statusMessage = "Error reading CubeSet data from database.";
                totalCubeSets = 0;
                return;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            dataAvail = true;
            if (statusMessage != null)
            {
                statusMessage += "; " + ex.Message;
            }
            else
            {
                statusMessage = ex.Message;
            }
            totalCubeSets = 0;
        }
    }

    private void OnSelectedItemChanged()
    {

    }

    private void EditCubeSet(CubeSet cs)
    {
        navman.NavigateTo($"/CubeSets/Edit/{cs.Id}");
    }

    private void EditSelectedCubeSet()
    {
        if (table.SelectedItem != null)
        {
            EditCubeSet(table.SelectedItem);
        }
    }

    private void NewCubeSet()
    {
        navman.NavigateTo("/CubeSets/New");
    }

    private async void DeleteCubeSet(CubeSet cs)
    {
        bool? result = await DialogService.ShowMessageBox("Delete CubeSet",
            $"Do you really want to delete CubeSet {cs.Id}? This process cannot be undone.",
            yesText: "Delete!", cancelText: "Cancel");

        if (result != null)
        {
            try
            {
                bool status = Global.db.DeleteCubeSet(cs.Id, user.Identity.Name);
                if (status)
                {
                    var par = new DialogParameters<InfoMsgBox>();
                    par.Add(x => x.ContentText, $"Deleted CubeSet {cs.Id}.");
                    Dialog.Show<InfoMsgBox>("Delete CubeSet", par);

                    Display();
                }
                else
                {
                    var par = new DialogParameters<InfoMsgBox>();
                    par.Add(x => x.ContentText, $"Error deleting CubeSet {cs.Id}.");
                    Dialog.Show<InfoMsgBox>("Delete CubeSet", par);
                }
            }
            catch (Exception ex)
            {
                dataAvail = true;
                if (statusMessage != null)
                {
                    statusMessage += "; " + ex.Message;
                }
                else
                {
                    statusMessage = ex.Message;
                }
            }
        }
    }

    private void DeleteSelectedCubeSet()
    {
        if (table.SelectedItem != null)
        {
            DeleteCubeSet(table.SelectedItem);
        }
    }

    // events
    private string SelectedRowClassFunc(CubeSet cs, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (table.SelectedItem != null && table.SelectedItem.Equals(cs))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    private void RowClicked(DataGridRowClickEventArgs<CubeSet> args)
    {
        long i = args.MouseEventArgs.Detail;
        if (i > 1)
        { // double click
            navman.NavigateTo($"/CubeSets/View/{args.Item.Id}");
        }
    }

    private void SelectedItemsChanged(HashSet<CubeSet> items)
    {
        int i = items.Count;
    }

    // quick filter - filter globally across multiple columns with the same input
    private Func<CubeSet, bool> QuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(searchStr))
            return true;

        if (x.Id.ToString().Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.ProjectId.ToString().Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.CastingDate.ToString("yyyy-MM-dd").Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SpecId.Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.TestCriteria.Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.ConcreteGrade.ToString().Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.ConcreteType.Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SupplierId.Contains(searchStr, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
}

