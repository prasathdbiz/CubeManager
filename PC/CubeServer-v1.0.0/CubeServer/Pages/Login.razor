@code {
    MudForm form;

    LoginUser loginUser = new LoginUser();
    string loginStatus;
    Session session;
    string[] errors = { };

    int showOTP = 0; // 0:Login, 1:OTP, 2:First Login
    MudTextField<string> otp;
    string validateStatus;

    string qrcode = "data:image/png;base64,";

    MudTextField<string> userid;
    MudTextField<string> password;

    Severity severity;

    protected async override void OnInitialized()
    {
        base.OnInitialized();

        try
        {
            Global.db?.CreateDefaultUsers();
        }
        catch
        {
        }
        showOTP = 0;
        otp = null;

        await AuthenticateSSOUser();
    }

    private async Task<bool> AuthenticateSSOUser()
    {
        var authState = await auth.GetAuthenticationStateAsync();
        var authUser = authState.User;
        if (authUser.Identity.IsAuthenticated)
        {
            return true;
        }

        return false;
    }

    private async void ValidateLogin()
    {
        bool status;

        loginUser.userId = userid.Text;
        loginUser.password = password.Text;

        CustomAuthenticationStateProvider cauth = (CustomAuthenticationStateProvider)auth;
        if (cauth.IsDevelopmentAdminCredential(loginUser.userId, loginUser.password))
        {
            cauth.AuthenticateUser((Database)Global.db, loginUser.userId, loginUser.password);
            severity = Severity.Success;
            loginStatus = "Login OK";
            await Task.Delay(1000);
            navMan.NavigateTo("/");
            return;
        }

        if (Global.app.par["Enable2FA"] > 0)
        {
            status = cauth.AuthenticateUserPassword((Database)Global.db, loginUser.userId, loginUser.password);
            if (status)
            {
                severity = Severity.Success;
                loginStatus = "Login OK";
                await Task.Delay(1000);

                if (cauth.HasSecret((Database)Global.db, loginUser.userId))
                {
                    showOTP = 1; // show OTP request
                }
                else
                {
                    showOTP = 2; // first time login

                    qrcode = cauth.SetupQRCodeForOTP((Database)Global.db, loginUser.userId);
                }
            }
            else
            {
                severity = Severity.Error;
                loginStatus = "Login Failed!";
            }
        }
        else
        {
            cauth.AuthenticateUser((Database)Global.db, loginUser.userId, loginUser.password);

            if (cauth.curUserClaims != null && cauth.curUserClaims.Identity.IsAuthenticated)
            {
                session = Global.db.CreateSession(loginUser.userId, "");
                severity = Severity.Success;
                loginStatus = "Login OK";
                await sessionStore.SetAsync("session", session);
                await Task.Delay(1000);
                navMan.NavigateTo("/");
            }
            else
            {
                session = null;
                severity = Severity.Error;
                loginStatus = "Login Failed!";
            }
        }

        StateHasChanged();
    }

    private async void ValidateOTP()
    {
        bool status;

        loginUser.otp = otp.Text;

        CustomAuthenticationStateProvider cauth = (CustomAuthenticationStateProvider)auth;
        if (Global.app.par["Enable2FA"] > 0)
        {
            status = cauth.AuthenticateUserOTP((Database)Global.db, loginUser.userId, loginUser.otp);
            if (status)
            {
                session = Global.db.CreateSession(loginUser.userId, "");
                severity = Severity.Success;
                validateStatus = "OTP Validated";
                await sessionStore.SetAsync("session", session);
                await Task.Delay(1000);
                navMan.NavigateTo("/");
            }
            else
            {
                severity = Severity.Error;
                validateStatus = "OTP Failed!";
            }

            StateHasChanged();
        }
        else
        {
            navMan.NavigateTo("/login", true);
        }
    }

    private void CloseQRCode()
    {
        navMan.NavigateTo("/login", true);
    }
}
