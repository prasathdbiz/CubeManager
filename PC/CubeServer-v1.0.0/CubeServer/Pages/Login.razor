@page "/login"
@layout BlankLayout

@using Microsoft.Extensions.Configuration
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@inject IConfiguration cfg
@inject AuthenticationStateProvider auth
@inject ProtectedSessionStorage sessionStore
@inject NavigationManager navMan

<PageTitle>Cube Manager Login</PageTitle>

<MudGrid Justify="Justify.Center">
    @if (showOTP == 0)
    {
        <MudItem>
            <MudPaper Class="pa-10" Width="450px" Height="330px">
                <MudImage Src="images/cube_manager.png" Height="60" Elevation="0" Class="rounded-lg" />
                <MudForm @ref="form">
                    <MudTextField T="string" Label="Username" @ref="userid" />
                    <MudTextField T="string" Label="Password" @ref="password" InputType="InputType.Password" />
                </MudForm>
                <MudStack Row="true" Class="mt-10">
                    <MudButton EndIcon="@Icons.Material.Filled.Login"Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" OnClick="@(()=>ValidateLogin())">Login</MudButton>
                    @if (@loginStatus != null)
                    {
                        <MudAlert Severity="@severity" Dense="true">@loginStatus</MudAlert>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    }
    else if (showOTP == 1)
    {
        <MudItem>
            <MudPaper Class="pa-10" Width="450px" Height="300px">
                <MudImage Src="images/cube_manager.png" Height="60" Elevation="0" Class="rounded-lg" />
                <MudForm @ref="form">
                    <MudTextField T="string" Label="Enter OTP" @ref="otp" />
                </MudForm>
                <MudStack Row="true" Class="mt-10">
                    <MudButton EndIcon="@Icons.Material.Filled.Login" Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" OnClick="@(()=>ValidateOTP())">Validate</MudButton>
                    @if (@validateStatus != null)
                    {
                        <MudAlert Severity="@severity" Dense="true">@validateStatus</MudAlert>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    }
    else if (showOTP == 2)
    {
        <MudItem>
            <MudPaper Class="justify-center pa-10" Width="450px" Height="500px">
                <MudImage Src="images/cube_manager.png" Height="60" Elevation="0" Class="rounded-lg" />
                <MudText Typo="Typo.h6">First time Login:</MudText>
                <MudText>Scan the QR Code below with your Microsoft Authenticator. Click Close when done.</MudText>
                <MudContainer Class="d-flex justify-center">
                <MudStack Class="mt-4">
                    <MudImage Src="@qrcode" Width="200" Elevation="0" Class="rounded-lg" />
                    <MudButton EndIcon="@Icons.Material.Filled.Close" Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" OnClick="@(()=>CloseQRCode())">Close</MudButton>
                </MudStack>
                </MudContainer>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

